# ============================================================
# WebToolOcean Widget Studio — Firebase Configuration
# ============================================================
# Copy this file to .env and fill in your Firebase credentials.
# Get these values from:
#   Firebase Console → Project Settings → Your Apps → Web App → Config
#
# IMPORTANT:
#   1. Enable "Google" and "Email/Password" in Firebase Console →
#      Authentication → Sign-in method
#   2. Add your domain to Firebase Console → Authentication →
#      Settings → Authorized domains
# ============================================================

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
